# Renova root env example (mobile + shared)
# Backend details: backend/.env.example
# Profiles: docs/ENVIRONMENT-PROFILES.md

ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./renova.db
# DATABASE_URL=postgresql+asyncpg://renova:renova@localhost:5433/renova
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=renova
S3_SECRET_KEY=renova123
S3_BUCKET=renova
PUBLIC_BASE_URL=http://127.0.0.1:8100
CONTRACTOR_FREE_PROJECT_LIMIT=1

# Comma-separated immutable user IDs. Required, unique and non-empty in
# staging/production; each ID must exist and have role=contractor before deploy.
ADMIN_USER_IDS=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_WEBHOOK_SECRET=

SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Multi-instance WebSocket fanout (required in staging/production).
REDIS_URL=

# «Мой налог» OAuth (disabled = no connected state is fabricated).
MOY_NALOG_ENABLED=false
MOY_NALOG_CLIENT_ID=
MOY_NALOG_CLIENT_SECRET=
MOY_NALOG_REDIRECT_URI=
MOY_NALOG_AUTHORIZE_URL=https://lknpd.nalog.ru/api/v1/auth/login
MOY_NALOG_TOKEN_URL=
# Required when enabled in staging/production. Generate independent secrets,
# newest/primary first; keep previous keys during a controlled rotation.
# Never reuse SECRET_KEY here.
MOY_NALOG_TOKEN_ENCRYPTION_KEYS=
# Local encrypted retention after access expiry only when provider returned a
# refresh token. This does not assert remote refresh-token validity.
MOY_NALOG_TOKEN_RECOVERY_RETENTION_DAYS=30
MOY_NALOG_TOKEN_EXPIRING_THRESHOLD_SEC=3600

# Comma-separated; staging/prod must not use *
CORS_ALLOWED_ORIGINS=
# Wave-10 ops
ALLOW_ACCOUNT_PURGE=false
