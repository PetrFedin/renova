# Renova root environment reference.
#
# Canonical LOCAL runtime uses:
#   env.local.example -> .env.local
#   npm run dev -- doctor
#   npm run dev -- bootstrap
#   npm run dev
#
# This generic file is kept for compatibility/reference only. Do not use it as a
# staging/production template. Backend-specific profiles live under backend/ and
# external staging has its own env.staging.example.

ENVIRONMENT=development

# Production-topology local defaults. SQLite is allowed only in explicitly
# bounded tests or direct legacy backend experiments, not the canonical runtime.
DATABASE_URL=postgresql+asyncpg://renova:renova@127.0.0.1:5433/renova
REDIS_URL=redis://127.0.0.1:6380/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=renova
S3_SECRET_KEY=renova123
S3_BUCKET=renova
PUBLIC_BASE_URL=http://127.0.0.1:8100
SECRET_KEY=renova-local-development-secret-key-32-bytes-only
ALLOW_CREATE_ALL=false
ALLOW_DEMO_SEED=true
AUTH_ALLOW_HEADER_USER_ID=true
CONTRACTOR_FREE_PROJECT_LIMIT=1
ADMIN_USER_IDS=

# Mobile local defaults. Canonical values are owned by env.local.example.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8100
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO=1

# External providers are intentionally unconfigured in local development.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_WEBHOOK_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
KONTUR_MODE=off
KONTUR_API_KEY=
GOSKEY_MODE=off
GOSKEY_CLIENT_ID=
ESIGN_WEBHOOK_SECRET=

# Observability sinks are optional locally; their external verification is a
# separate production-readiness contour.
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
LOG_JSON=false
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=

# «Мой налог» OAuth is disabled unless a dedicated provider environment is being
# exercised deliberately. Never copy real provider secrets into local examples.
MOY_NALOG_ENABLED=false
MOY_NALOG_CLIENT_ID=
MOY_NALOG_CLIENT_SECRET=
MOY_NALOG_REDIRECT_URI=
MOY_NALOG_AUTHORIZE_URL=https://lknpd.nalog.ru/api/v1/auth/login
MOY_NALOG_TOKEN_URL=
MOY_NALOG_TOKEN_ENCRYPTION_KEYS=
MOY_NALOG_TOKEN_RECOVERY_RETENTION_DAYS=30
MOY_NALOG_TOKEN_EXPIRING_THRESHOLD_SEC=3600

CORS_ALLOWED_ORIGINS=
ALLOW_ACCOUNT_PURGE=false
ACCOUNT_PURGE_OPS_SECRET=
