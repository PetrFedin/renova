# === Profile ===
# development | test | staging | production
ENVIRONMENT=development

# --- development (SQLite and demo/header auth are allowed by policy) ---
DATABASE_URL=sqlite+aiosqlite:///./renova.db
# PostgreSQL only; explicit QueuePool defaults used by capacity telemetry.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SEC=30
PUBLIC_BASE_URL=http://127.0.0.1:8100
SECRET_KEY=dev-secret-change-me
ADMIN_USER_IDS=
# JWT access token TTL (minutes). Default: 14 days.
# ACCESS_TOKEN_EXPIRE_MINUTES=20160

# --- staging / production minimum runtime contract ---
# ENVIRONMENT=staging
# DATABASE_URL=postgresql+asyncpg://renova:replace@postgres:5432/renova
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SEC=30
# REDIS_URL=redis://redis:6379/0
# PUBLIC_BASE_URL=https://api-staging.renova.app
# SECRET_KEY=replace-with-openssl-rand-hex-32
# CORS_ALLOWED_ORIGINS=https://staging.renova.app
# AUTH_ALLOW_HEADER_USER_ID=false
# ADMIN_USER_IDS=immutable-contractor-user-id-1,immutable-contractor-user-id-2
# ALLOW_CREATE_ALL=false
# ALLOW_DEMO_SEED=false
# DOCUMENT_OCR_MODE=metadata
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=replace-with-provider-token
# TWILIO_FROM=+15005550006
#
# ADMIN_USER_IDS must contain unique, non-empty immutable IDs. After the users
# exist, live preflight verifies that every ID has role=contractor without
# printing the IDs. It never creates users or changes roles automatically.
#
# Required deployment order:
#   poetry run python -m alembic upgrade head
#   poetry run python -m app.core.runtime_preflight
#   renova-api
#
# Staging/production fail startup when PostgreSQL/Redis/Twilio or the admin
# allowlist format is unsafe. Production additionally requires external Sentry,
# OTLP telemetry, TLS transport for OTLP and JSON logs.

# Optional overrides. Keep false/unset in staging and production.
# ALLOW_CREATE_ALL=true
# ALLOW_DEMO_SEED=true
# AUTH_ALLOW_HEADER_USER_ID=true

FNS_NPD_STATUS_URL=https://statusnpd.nalog.ru/api/v1/tracker/taxpayer_status

# Object storage. Empty S3 settings use the local uploads directory.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=renova
UPLOADS_DIR=./uploads
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
S3_PUBLIC_URL=

# Payments. Optional for API startup; required for live checkout/readiness.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_WEBHOOK_SECRET=

# Observability. Local/test may leave sinks empty. Staging reports explicit
# warnings while empty; production refuses startup until both sinks are set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=renova-api
OTEL_TRACES_SAMPLE_RATE=0.1
LOG_JSON=false

# E-sign external providers. Off keeps truthful in-app signing only.
KONTUR_MODE=off
KONTUR_API_KEY=
KONTUR_API_URL=https://api.kontur.ru/sign/v1
GOSKEY_MODE=off
GOSKEY_CLIENT_ID=
ESIGN_WEBHOOK_SECRET=

# Ops alerts / optional AI digest.
OPS_ALERT_EMAIL=
OLLAMA_DIGEST_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3

# SMTP becomes a required complete set when OPS_ALERT_EMAIL is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# FNS receipt live verification. Empty credentials keep the live integration off.
FNS_RECEIPT_LOGIN=
FNS_RECEIPT_PASSWORD=

# Moy Nalog OAuth. Keep disabled until real partner credentials/endpoints exist.
MOY_NALOG_ENABLED=false
MOY_NALOG_CLIENT_ID=
MOY_NALOG_CLIENT_SECRET=
MOY_NALOG_REDIRECT_URI=
MOY_NALOG_AUTHORIZE_URL=https://lknpd.nalog.ru/api/v1/auth/login
MOY_NALOG_TOKEN_URL=

# Comma-separated. Staging/production must never use *.
CORS_ALLOWED_ORIGINS=

# OCR is metadata-only until a real content-reading engine is implemented.
DOCUMENT_OCR_MODE=metadata
DOCUMENT_OCR_WORKER_INTERVAL_SEC=5

# Background automation runs in the separate renova-worker process.
AUTOMATION_REMINDERS_ENABLED=true
AUTOMATION_REMINDERS_INTERVAL_SEC=900

# Hard purge requires this flag plus an authenticated contractor and ops secret.
ALLOW_ACCOUNT_PURGE=false
ACCOUNT_PURGE_OPS_SECRET=
