# Renova — production template. Do NOT commit real values; keep them in the
# deployment provider's secret manager. Every REQUIRED line below is enforced
# at startup (app.core.environment / observability / runtime_policy): a missing
# or unsafe value stops the API and the worker instead of degrading silently.
#
# Release order (same immutable image digest for all three steps):
#   1. alembic upgrade head          (one-off job)
#   2. python -m app.core.runtime_preflight
#   3. renova-api  +  renova-worker  (RENOVA_IMAGE_DIGEST set on both)
# See docs/RELEASE-RUNBOOK.md and docs/STAGING-RELEASE.md.

ENVIRONMENT=production

# --- REQUIRED: database / cache -------------------------------------------
# PostgreSQL only (SQLite is rejected). Use a managed instance with PITR.
DATABASE_URL=postgresql+asyncpg://renova:CHANGE_ME@managed-postgres:5432/renova
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SEC=30
# Shared OTP store, rate limiter and worker heartbeat. Missing = startup fails;
# if Redis is down the public API answers 503 rate_limit_backend_unavailable.
REDIS_URL=rediss://managed-redis:6379/0

# --- REQUIRED: public identity and secrets ---------------------------------
# https only, not localhost.
PUBLIC_BASE_URL=https://api.YOUR-DOMAIN.com
# openssl rand -hex 32  (>= 32 bytes, not a default value)
SECRET_KEY=
# Explicit origins only. With the variable empty the API allows PUBLIC_BASE_URL
# alone; never set "*" (the code does not forbid it, review it by hand).
CORS_ALLOWED_ORIGINS=https://YOUR-DOMAIN.com

# Set by the deployment platform to the promoted GHCR digest on BOTH the api
# and the worker role. Without it /health reports "unknown".
RENOVA_IMAGE_DIGEST=sha256:replace-with-promoted-ghcr-digest

# --- REQUIRED: auth / schema policy (forbidden values fail startup) --------
AUTH_ALLOW_HEADER_USER_ID=false
ALLOW_CREATE_ALL=false
ALLOW_DEMO_SEED=false
# Unique, comma-separated immutable user ids; each must exist with role=contractor.
ADMIN_USER_IDS=

# --- REQUIRED: SMS (no demo-success in production) -------------------------
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- REQUIRED: observability (production fails without them) ---------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# https/grpc collector; localhost and OTEL_EXPORTER_OTLP_INSECURE=true are rejected.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=renova-api
OTEL_TRACES_SAMPLE_RATE=0.1
LOG_JSON=true

# --- Object storage (media, documents) --------------------------------------
# All four together = S3 mode. If ALL are empty the API silently uses local
# disk under UPLOADS_DIR, which is ephemeral in a container: production MUST
# set them (the code does not enforce this; see PRODUCTION-READINESS.md).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=renova
# Public base for presigned/media URLs when it differs from S3_ENDPOINT.
S3_PUBLIC_URL=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=

# --- Rate limit -------------------------------------------------------------
# Requests per minute per identity (Redis-backed). Behind a load balancer also
# set FORWARDED_ALLOW_IPS on the api process so the client IP is the real one.
RATE_LIMIT_RPM=120

# --- Provider ports: off | real (simulated is forbidden in staging/production)
# "real" requires that provider's credentials; "off" disables the capability.
PAYMENT_PROVIDER_MODE=off
FISCAL_RECEIPT_PROVIDER_MODE=off
NPD_STATUS_PROVIDER_MODE=off
SMS_PROVIDER_MODE=off
PUSH_PROVIDER_MODE=off

# --- Payments (YooKassa) ----------------------------------------------------
# Without these, checkout answers 503 (demo is disabled). Webhook URL:
# {PUBLIC_BASE_URL}/api/v1/subscription/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_WEBHOOK_SECRET=

# --- «Мой налог» (НПД) -------------------------------------------------------
# Enable only after real provider credentials exist. When enabled the keyring is
# mandatory and independent from SECRET_KEY (newest key first).
MOY_NALOG_ENABLED=false
MOY_NALOG_CLIENT_ID=
MOY_NALOG_CLIENT_SECRET=
MOY_NALOG_REDIRECT_URI=https://api.YOUR-DOMAIN.com/api/v1/fns/moy-nalog/oauth/callback
MOY_NALOG_AUTHORIZE_URL=https://lknpd.nalog.ru/api/v1/auth/login
MOY_NALOG_TOKEN_URL=
MOY_NALOG_TOKEN_ENCRYPTION_KEYS=
MOY_NALOG_TOKEN_RECOVERY_RETENTION_DAYS=30
MOY_NALOG_TOKEN_EXPIRING_THRESHOLD_SEC=3600

# --- FNS receipts (proverkacheka, Basic auth) -------------------------------
FNS_RECEIPT_LOGIN=
FNS_RECEIPT_PASSWORD=

# --- E-sign ----------------------------------------------------------------
# KONTUR_MODE=off|sandbox|live ; goskey is not implemented (keep off).
KONTUR_MODE=off
KONTUR_API_KEY=
GOSKEY_MODE=off
# Required when KONTUR_MODE=sandbox|live, otherwise webhooks answer 503.
ESIGN_WEBHOOK_SECRET=

# --- Ops alerts / mail (optional; empty = log-only) -------------------------
# OPS_ALERT_EMAIL requires SMTP_HOST in production.
OPS_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
OLLAMA_DIGEST_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3

# --- Metadata-only OCR; background loops -----------------------------------
DOCUMENT_OCR_MODE=metadata
PUSH_RECEIPT_WORKER_ENABLED=true
PUSH_RECEIPT_WORKER_INTERVAL_SEC=60

# --- Destructive operations stay off ---------------------------------------
ALLOW_ACCOUNT_PURGE=false
ACCOUNT_PURGE_OPS_SECRET=
