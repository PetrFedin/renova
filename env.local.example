# Renova canonical local development profile.
# Canonical dev commands materialize .env.local from this file when absent.
# Use `npm run dev -- bootstrap` when locked dependencies need installation.
# This file is LOCAL ONLY. Staging/production use their dedicated examples and
# must never be loaded by scripts/dev-runtime.sh.

ENVIRONMENT=development

# Host-facing local dependencies. Docker Compose overrides hostnames for the
# API/worker containers while preserving the same ports and credentials.
DATABASE_URL=postgresql+asyncpg://renova:renova@127.0.0.1:5433/renova
REDIS_URL=redis://127.0.0.1:6380/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=renova
S3_SECRET_KEY=renova123
S3_BUCKET=renova
S3_PUBLIC_URL=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
PUBLIC_BASE_URL=http://127.0.0.1:8100
SECRET_KEY=renova-local-development-secret-key-32-bytes-only

# Local policy: schema is Alembic-only even in development; demo/header auth is
# deliberately enabled only for the local profile.
ALLOW_CREATE_ALL=false
ALLOW_DEMO_SEED=true
AUTH_ALLOW_HEADER_USER_ID=true
ADMIN_USER_IDS=

# Mobile / Expo local truth.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8100
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEMO=1
EXPO_PUBLIC_SENTRY_DSN=

# External providers are intentionally OFF locally. Their absence must not be
# interpreted as a staging/production verification result.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_WEBHOOK_SECRET=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
KONTUR_MODE=off
KONTUR_API_KEY=
GOSKEY_MODE=off
GOSKEY_CLIENT_ID=
ESIGN_WEBHOOK_SECRET=
MOY_NALOG_ENABLED=false
MOY_NALOG_CLIENT_ID=
MOY_NALOG_CLIENT_SECRET=
MOY_NALOG_REDIRECT_URI=
MOY_NALOG_TOKEN_URL=
MOY_NALOG_TOKEN_ENCRYPTION_KEYS=
FNS_RECEIPT_LOGIN=
FNS_RECEIPT_PASSWORD=

# External observability/alert sinks are intentionally disabled in canonical
# local development. Production/staging verification belongs to #283.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
LOG_JSON=false
OPS_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local worker topology stays active, but provider-specific integrations remain
# disabled/unconfigured. These tasks exercise the dedicated worker ownership.
AUTOMATION_REMINDERS_ENABLED=true
AUTOMATION_REMINDERS_INTERVAL_SEC=900
PUSH_RECEIPT_WORKER_ENABLED=false

DOCUMENT_OCR_MODE=metadata
DOCUMENT_OCR_WORKER_INTERVAL_SEC=5
OLLAMA_DIGEST_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3
CORS_ALLOWED_ORIGINS=
ALLOW_ACCOUNT_PURGE=false
ACCOUNT_PURGE_OPS_SECRET=
