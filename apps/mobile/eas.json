{
  "cli": {
    "version": "21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.22.2",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8100",
        "EXPO_PUBLIC_DEMO": "1",
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.22.2",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "simulator": false,
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://PLACEHOLDER-api-staging.invalid",
        "EXPO_PUBLIC_DEMO": "0",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "channel": "testflight",
      "node": "22.22.2",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium",
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://PLACEHOLDER-api-staging.invalid",
        "EXPO_PUBLIC_DEMO": "0",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.22.2",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "channel": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://PLACEHOLDER-api-production.invalid",
        "EXPO_PUBLIC_DEMO": "0",
        "SENTRY_ORG": "renova",
        "SENTRY_PROJECT": "mobile",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "staging": {
      "extends": "preview",
      "distribution": "internal",
      "channel": "staging",
      "node": "22.22.2",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://PLACEHOLDER-api-staging.invalid",
        "EXPO_PUBLIC_DEMO": "0",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "PLACEHOLDER_ASC_APP_ID",
        "appleTeamId": "PLACEHOLDER_APPLE_TEAM_ID"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "PLACEHOLDER_ASC_APP_ID",
        "appleTeamId": "PLACEHOLDER_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "PLACEHOLDER_GOOGLE_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal"
      }
    }
  }
}
