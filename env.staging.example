# Renova external staging configuration template.
# Keep real values in the deployment provider / secret manager; never commit them.
#
# Canonical deployment order:
#   1. Select the already-published immutable artifact:
#        ghcr.io/petrfedin/renova-api@sha256:<DIGEST>
#   2. Run `alembic upgrade head` as a one-off job using that SAME image digest.
#   3. Start API replica(s) from that SAME image digest with the variables below.
#   4. Set RENOVA_IMAGE_DIGEST to the exact promoted sha256 digest.
#   5. Run the GitHub `External staging release` workflow with the same Git SHA + digest.
#
# Do not deploy staging by cloning the repository and resolving/installing Poetry dependencies.

ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://renova:CHANGE_ME@managed-postgres:5432/renova
# Per-API-process SQLAlchemy pool contract. Capacity evidence uses this denominator.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SEC=30
REDIS_URL=redis://managed-redis:6379/0
SECRET_KEY=replace-with-random-32plus-chars
PUBLIC_BASE_URL=https://api.YOUR-DOMAIN.com
CORS_ALLOWED_ORIGINS=https://YOUR-DOMAIN.com

# Required for external immutable-release attestation.
# The Git SHA is baked into the canonical image; the registry digest is known only after publication
# and must be injected by the deployment platform.
RENOVA_IMAGE_DIGEST=sha256:replace-with-promoted-ghcr-digest

AUTH_ALLOW_HEADER_USER_ID=false
ALLOW_CREATE_ALL=false
ALLOW_DEMO_SEED=false
DOCUMENT_OCR_MODE=metadata

# Required. Unique comma-separated immutable user IDs, no empty elements.
# Each user must already exist with role=contractor when live preflight runs.
ADMIN_USER_IDS=replace-with-real-contractor-user-id

# Required working SMS provider configuration. No preview/demo success in staging.
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=replace-with-provider-token
TWILIO_FROM=+15005550006

# Optional for API startup, required for live checkout and H0 readiness.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_WEBHOOK_SECRET=

# External observability. Empty values keep staging explicit-but-not-proven and
# produce startup/preflight warnings. Production requires both sinks and JSON logs.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=renova-api
OTEL_TRACES_SAMPLE_RATE=0.1
LOG_JSON=true

# Optional external integrations.
KONTUR_MODE=off
KONTUR_API_KEY=
ESIGN_WEBHOOK_SECRET=

# GitHub environment `staging` release-verification settings (configure in GitHub, not here):
# STAGING_API_BASE_URL=https://api.YOUR-DOMAIN.com            # environment variable
# STAGING_ADMIN_BEARER_TOKEN=<staging-only-admin-JWT>         # environment secret

# Mobile / EAS environment:
# EXPO_PUBLIC_API_URL=https://api.YOUR-DOMAIN.com
# EXPO_PUBLIC_APP_ENV=staging
# EXPO_PUBLIC_DEMO=0
